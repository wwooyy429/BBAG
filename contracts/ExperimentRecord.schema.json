{
  "additionalProperties": false,
  "properties": {
    "code_commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code Commit"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "economic_status": {
      "const": "NOT_EVALUATED",
      "default": "NOT_EVALUATED",
      "title": "Economic Status",
      "type": "string"
    },
    "platform_status": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Platform Status",
      "type": "string"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "review_status": {
      "const": "PENDING",
      "default": "PENDING",
      "title": "Review Status",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "const": "S0",
      "default": "S0",
      "title": "Stage",
      "type": "string"
    },
    "validation_status": {
      "const": "VALIDATED",
      "default": "VALIDATED",
      "title": "Validation Status",
      "type": "string"
    },
    "working_tree_dirty": {
      "title": "Working Tree Dirty",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "protocol_sha256",
    "code_commit",
    "working_tree_dirty",
    "created_at"
  ],
  "title": "ExperimentRecord",
  "type": "object"
}
