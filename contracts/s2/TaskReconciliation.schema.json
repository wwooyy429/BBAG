{
  "additionalProperties": false,
  "description": "Explicit, unauthenticated assertion that the prior submission did not occur.\n\nThe caller must actually perform this lookup/manual reconciliation. Supplying\nthe model itself is not authentication or authorization for another attempt.",
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "evidence_authentication": {
      "const": "NOT_AUTHENTICATED",
      "default": "NOT_AUTHENTICATED",
      "title": "Evidence Authentication",
      "type": "string"
    },
    "kind": {
      "const": "NOT_SUBMITTED",
      "default": "NOT_SUBMITTED",
      "title": "Kind",
      "type": "string"
    },
    "lookup_method": {
      "enum": [
        "PROVIDER_IDEMPOTENCY_LOOKUP",
        "PROVIDER_REQUEST_LOOKUP",
        "OWNER_MANUAL_RECONCILIATION"
      ],
      "title": "Lookup Method",
      "type": "string"
    },
    "operation": {
      "enum": [
        "compile",
        "research_check",
        "data_query",
        "project_read",
        "file_read",
        "research_read"
      ],
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "request_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_class": {
      "default": "CONTROL_ONLY",
      "enum": [
        "CONTROL_ONLY",
        "SYNTHETIC_TEST"
      ],
      "title": "Response Class",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "lookup_method",
    "checked_at",
    "operation",
    "source_commit",
    "config_sha256",
    "request_sha256"
  ],
  "title": "TaskReconciliation",
  "type": "object"
}
