{
  "additionalProperties": false,
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "compile",
        "research_check",
        "data_query",
        "project_read",
        "file_read",
        "research_read"
      ],
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_class": {
      "default": "CONTROL_ONLY",
      "enum": [
        "CONTROL_ONLY",
        "SYNTHETIC_TEST"
      ],
      "title": "Response Class",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "stage": {
      "const": "S2",
      "default": "S2",
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "correlation_id",
    "operation",
    "source_commit",
    "config_sha256",
    "request_sha256"
  ],
  "title": "TaskSpec",
  "type": "object"
}
