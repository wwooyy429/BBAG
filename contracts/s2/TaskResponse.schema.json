{
  "additionalProperties": false,
  "description": "Whitelisted metadata, not arbitrary provider JSON or a market-data digest.",
  "properties": {
    "actual_cost_microusd": {
      "anyOf": [
        {
          "maximum": 1000000000000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Cost Microusd"
    },
    "cell_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cell Index"
    },
    "check_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Check Passed"
    },
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "error_category": {
      "default": "NONE",
      "enum": [
        "NONE",
        "INVALID_REQUEST",
        "ACCESS_DENIED",
        "CAPABILITY_UNAVAILABLE",
        "PROVIDER_ERROR",
        "TIMEOUT",
        "MALFORMED_RESPONSE"
      ],
      "title": "Error Category",
      "type": "string"
    },
    "invocation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invocation Id"
    },
    "operation": {
      "enum": [
        "compile",
        "research_check",
        "data_query",
        "project_read",
        "file_read",
        "research_read"
      ],
      "title": "Operation",
      "type": "string"
    },
    "platform_task_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Task Id"
    },
    "project_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_class": {
      "default": "CONTROL_ONLY",
      "enum": [
        "CONTROL_ONLY",
        "SYNTHETIC_TEST"
      ],
      "title": "Response Class",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "compiling",
        "compiled",
        "running",
        "run_finished",
        "result_available",
        "completed",
        "error",
        "incomplete",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Success"
    }
  },
  "required": [
    "operation",
    "source_commit",
    "config_sha256",
    "request_sha256",
    "status"
  ],
  "title": "TaskResponse",
  "type": "object"
}
