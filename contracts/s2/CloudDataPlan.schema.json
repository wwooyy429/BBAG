{
  "$defs": {
    "DataRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "classification": {
          "default": "UNKNOWN",
          "enum": [
            "DEVELOPMENT",
            "SEALED_FINAL",
            "SEALED_DERIVATIVE",
            "UNKNOWN"
          ],
          "title": "Classification",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "enum": [
              "DEVELOPMENT",
              "SEALED_FINAL",
              "SEALED_DERIVATIVE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "maxItems": 32,
          "title": "Derived From",
          "type": "array"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "fields": {
          "items": {
            "enum": [
              "open",
              "high",
              "low",
              "close",
              "volume"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "output_mode": {
          "default": "LOCAL_DATA",
          "enum": [
            "LOCAL_DATA",
            "CONTROL_ONLY",
            "IN_CLOUD_DATA"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "enum": [
            "SYNTHETIC",
            "QUANTCONNECT_CLOUD"
          ],
          "title": "Provider",
          "type": "string"
        },
        "purpose": {
          "default": "ENGINEERING_TEST",
          "enum": [
            "ENGINEERING_TEST",
            "DEVELOPMENT"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "start",
        "end",
        "assets",
        "fields",
        "as_of"
      ],
      "title": "DataRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "max_history_rows": {
      "default": 32,
      "maximum": 128,
      "minimum": 1,
      "title": "Max History Rows",
      "type": "integer"
    },
    "owner_policy_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Owner Policy Sha256",
      "type": "string"
    },
    "project_id": {
      "const": 38698074,
      "title": "Project Id",
      "type": "integer"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/DataRequest"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "stage": {
      "const": "S2",
      "default": "S2",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "source_commit",
    "config_sha256",
    "owner_policy_sha256",
    "request"
  ],
  "title": "CloudDataPlan",
  "type": "object"
}
