{
  "$defs": {
    "CalendarSession": {
      "additionalProperties": false,
      "description": "An explicit supplied exchange session; no inferred weekday filling.",
      "properties": {
        "close_at": {
          "format": "date-time",
          "title": "Close At",
          "type": "string"
        },
        "open_at": {
          "format": "date-time",
          "title": "Open At",
          "type": "string"
        },
        "session": {
          "format": "date",
          "title": "Session",
          "type": "string"
        },
        "signal_at": {
          "format": "date-time",
          "title": "Signal At",
          "type": "string"
        }
      },
      "required": [
        "session",
        "open_at",
        "close_at",
        "signal_at"
      ],
      "title": "CalendarSession",
      "type": "object"
    },
    "CorporateAction": {
      "additionalProperties": false,
      "properties": {
        "cash_per_share": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash Per Share"
        },
        "effective_on": {
          "format": "date",
          "title": "Effective On",
          "type": "string"
        },
        "kind": {
          "enum": [
            "SPLIT",
            "DIVIDEND"
          ],
          "title": "Kind",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "shares_after_per_before": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares After Per Before"
        },
        "sid": {
          "minLength": 1,
          "title": "Sid",
          "type": "string"
        }
      },
      "required": [
        "sid",
        "kind",
        "effective_on",
        "known_at"
      ],
      "title": "CorporateAction",
      "type": "object"
    },
    "DailyBar": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "close": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Close"
        },
        "high": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "open": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
        "session": {
          "format": "date",
          "title": "Session",
          "type": "string"
        },
        "sid": {
          "minLength": 1,
          "title": "Sid",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "sid",
        "session",
        "available_at"
      ],
      "title": "DailyBar",
      "type": "object"
    },
    "DataProvenance": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "default": "UNKNOWN",
          "enum": [
            "DEVELOPMENT",
            "SEALED_FINAL",
            "SEALED_DERIVATIVE",
            "UNKNOWN"
          ],
          "title": "Classification",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "enum": [
              "DEVELOPMENT",
              "SEALED_FINAL",
              "SEALED_DERIVATIVE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "maxItems": 32,
          "title": "Derived From",
          "type": "array"
        },
        "normalization": {
          "const": "raw",
          "default": "raw",
          "title": "Normalization",
          "type": "string"
        },
        "price_semantics": {
          "const": "unadjusted_trade_price",
          "default": "unadjusted_trade_price",
          "title": "Price Semantics",
          "type": "string"
        },
        "provider": {
          "enum": [
            "SYNTHETIC",
            "QUANTCONNECT_CLOUD"
          ],
          "title": "Provider",
          "type": "string"
        },
        "provider_data_version": {
          "minLength": 1,
          "title": "Provider Data Version",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_sha256": {
          "description": "SHA-256 of original provider input bytes; licensed data hashes remain inside cloud and never enter control metadata",
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "volume_semantics": {
          "const": "unadjusted_shares",
          "default": "unadjusted_shares",
          "title": "Volume Semantics",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_data_version",
        "source_sha256",
        "request_sha256",
        "retrieved_at"
      ],
      "title": "DataProvenance",
      "type": "object"
    },
    "DataRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "classification": {
          "default": "UNKNOWN",
          "enum": [
            "DEVELOPMENT",
            "SEALED_FINAL",
            "SEALED_DERIVATIVE",
            "UNKNOWN"
          ],
          "title": "Classification",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "enum": [
              "DEVELOPMENT",
              "SEALED_FINAL",
              "SEALED_DERIVATIVE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "maxItems": 32,
          "title": "Derived From",
          "type": "array"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "fields": {
          "items": {
            "enum": [
              "open",
              "high",
              "low",
              "close",
              "volume"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "output_mode": {
          "default": "LOCAL_DATA",
          "enum": [
            "LOCAL_DATA",
            "CONTROL_ONLY",
            "IN_CLOUD_DATA"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "enum": [
            "SYNTHETIC",
            "QUANTCONNECT_CLOUD"
          ],
          "title": "Provider",
          "type": "string"
        },
        "purpose": {
          "default": "ENGINEERING_TEST",
          "enum": [
            "ENGINEERING_TEST",
            "DEVELOPMENT"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "start",
        "end",
        "assets",
        "fields",
        "as_of"
      ],
      "title": "DataRequest",
      "type": "object"
    },
    "MembershipEvent": {
      "additionalProperties": false,
      "properties": {
        "effective_on": {
          "format": "date",
          "title": "Effective On",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "member": {
          "title": "Member",
          "type": "boolean"
        },
        "sid": {
          "minLength": 1,
          "title": "Sid",
          "type": "string"
        }
      },
      "required": [
        "sid",
        "effective_on",
        "member",
        "known_at"
      ],
      "title": "MembershipEvent",
      "type": "object"
    },
    "SecurityIdentity": {
      "additionalProperties": false,
      "properties": {
        "delisted_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delisted On"
        },
        "delisting_known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delisting Known At"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "listed_from": {
          "format": "date",
          "title": "Listed From",
          "type": "string"
        },
        "sid": {
          "minLength": 1,
          "title": "Sid",
          "type": "string"
        }
      },
      "required": [
        "sid",
        "listed_from",
        "known_at"
      ],
      "title": "SecurityIdentity",
      "type": "object"
    },
    "TickerMapping": {
      "additionalProperties": false,
      "properties": {
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "sid": {
          "minLength": 1,
          "title": "Sid",
          "type": "string"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "valid_to_known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To Known At"
        }
      },
      "required": [
        "sid",
        "ticker",
        "valid_from",
        "known_at"
      ],
      "title": "TickerMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bars": {
      "items": {
        "$ref": "#/$defs/DailyBar"
      },
      "maxItems": 8192,
      "title": "Bars",
      "type": "array"
    },
    "calendar_id": {
      "minLength": 1,
      "title": "Calendar Id",
      "type": "string"
    },
    "calendar_version": {
      "minLength": 1,
      "title": "Calendar Version",
      "type": "string"
    },
    "corporate_actions": {
      "items": {
        "$ref": "#/$defs/CorporateAction"
      },
      "maxItems": 1024,
      "title": "Corporate Actions",
      "type": "array"
    },
    "currency": {
      "const": "USD",
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "data_id": {
      "minLength": 1,
      "title": "Data Id",
      "type": "string"
    },
    "frequency": {
      "const": "daily",
      "default": "daily",
      "title": "Frequency",
      "type": "string"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/SecurityIdentity"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Identities",
      "type": "array"
    },
    "market": {
      "const": "USA",
      "default": "USA",
      "title": "Market",
      "type": "string"
    },
    "membership": {
      "items": {
        "$ref": "#/$defs/MembershipEvent"
      },
      "maxItems": 1024,
      "title": "Membership",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/DataProvenance"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/DataRequest"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/CalendarSession"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Sessions",
      "type": "array"
    },
    "stage": {
      "const": "S2",
      "default": "S2",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Status",
      "type": "string"
    },
    "tickers": {
      "items": {
        "$ref": "#/$defs/TickerMapping"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Tickers",
      "type": "array"
    },
    "timezone": {
      "default": "America/New_York",
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "data_id",
    "calendar_id",
    "calendar_version",
    "request",
    "provenance",
    "sessions",
    "identities",
    "tickers",
    "bars"
  ],
  "title": "StandardDataBundle",
  "type": "object"
}
