{
  "additionalProperties": false,
  "description": "The complete output allowlist: no free text or market observations.",
  "properties": {
    "check_results": {
      "additionalProperties": {
        "type": "boolean"
      },
      "maxProperties": 7,
      "propertyNames": {
        "enum": [
          "data_presence",
          "requested_bounds",
          "field_availability",
          "normalization_raw",
          "point_in_time",
          "identity_consistency",
          "no_data_export"
        ]
      },
      "title": "Check Results",
      "type": "object"
    },
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "error_category": {
      "default": "NONE",
      "enum": [
        "NONE",
        "INVALID_REQUEST",
        "ACCESS_DENIED",
        "CAPABILITY_UNAVAILABLE",
        "PROVIDER_ERROR",
        "TIMEOUT",
        "MALFORMED_RESPONSE"
      ],
      "title": "Error Category",
      "type": "string"
    },
    "operation": {
      "const": "research_check",
      "default": "research_check",
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "minimum": 1,
      "title": "Project Id",
      "type": "integer"
    },
    "request_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "COMPLETED",
        "ERROR",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "request_sha256",
    "source_commit",
    "config_sha256",
    "status"
  ],
  "title": "QuantConnectCheckResponse",
  "type": "object"
}
