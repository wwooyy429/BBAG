{
  "$defs": {
    "CloudSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "owner_policy_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Owner Policy Sha256",
          "type": "string"
        },
        "project_id": {
          "exclusiveMinimum": 0,
          "title": "Project Id",
          "type": "integer"
        },
        "request_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "source_commit",
        "config_sha256",
        "request_sha256",
        "owner_policy_sha256"
      ],
      "title": "CloudSourceBinding",
      "type": "object"
    },
    "CloudStandardizationChecks": {
      "additionalProperties": false,
      "properties": {
        "alias_sid_binding": {
          "const": "PASS",
          "default": "PASS",
          "title": "Alias Sid Binding",
          "type": "string"
        },
        "cloud_cache_persistence": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Cloud Cache Persistence",
          "type": "string"
        },
        "corporate_action_records": {
          "enum": [
            "PASS",
            "UNVERIFIED"
          ],
          "title": "Corporate Action Records",
          "type": "string"
        },
        "declared_calendar_consistency": {
          "const": "PASS",
          "default": "PASS",
          "title": "Declared Calendar Consistency",
          "type": "string"
        },
        "declared_snapshot_clock": {
          "const": "PASS",
          "default": "PASS",
          "title": "Declared Snapshot Clock",
          "type": "string"
        },
        "membership_quality_coverage": {
          "enum": [
            "PASS",
            "FAIL",
            "UNVERIFIED"
          ],
          "title": "Membership Quality Coverage",
          "type": "string"
        },
        "membership_records": {
          "enum": [
            "PASS",
            "UNVERIFIED"
          ],
          "title": "Membership Records",
          "type": "string"
        },
        "platform_recovery": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Platform Recovery",
          "type": "string"
        },
        "provider_disclosure_revision_truth": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Provider Disclosure Revision Truth",
          "type": "string"
        },
        "provider_identity_history_truth": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Provider Identity History Truth",
          "type": "string"
        },
        "raw_standardization": {
          "const": "PASS",
          "default": "PASS",
          "title": "Raw Standardization",
          "type": "string"
        },
        "requested_field_coverage": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Requested Field Coverage",
          "type": "string"
        }
      },
      "required": [
        "requested_field_coverage",
        "membership_quality_coverage",
        "membership_records",
        "corporate_action_records"
      ],
      "title": "CloudStandardizationChecks",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/CloudSourceBinding"
    },
    "checks": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudStandardizationChecks"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "economic_evidence": {
      "const": "NOT_APPLICABLE",
      "default": "NOT_APPLICABLE",
      "title": "Economic Evidence",
      "type": "string"
    },
    "error_category": {
      "anyOf": [
        {
          "const": "STANDARDIZATION_REJECTED",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Category"
    },
    "evidence_class": {
      "const": "DECLARED_INPUT_CHECKS",
      "default": "DECLARED_INPUT_CHECKS",
      "title": "Evidence Class",
      "type": "string"
    },
    "independent_review": {
      "const": "PENDING",
      "default": "PENDING",
      "title": "Independent Review",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "CHECKS_COMPLETED",
        "ERROR"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "platform_integration": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Platform Integration",
      "type": "string"
    },
    "provider_authentication": {
      "const": "NOT_AUTHENTICATED",
      "default": "NOT_AUTHENTICATED",
      "title": "Provider Authentication",
      "type": "string"
    },
    "purpose": {
      "const": "ENGINEERING_TEST",
      "default": "ENGINEERING_TEST",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "const": "S2",
      "default": "S2",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "binding",
    "outcome"
  ],
  "title": "CloudStandardizationReceipt",
  "type": "object"
}
