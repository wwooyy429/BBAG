{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "code_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Code Commit",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "review_status": {
      "const": "PENDING",
      "default": "PENDING",
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "code_commit",
    "config_sha256",
    "artifacts"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
