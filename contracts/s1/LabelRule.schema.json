{
  "additionalProperties": false,
  "properties": {
    "benchmark_asset": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Asset"
    },
    "entry_rule": {
      "const": "next_session_open",
      "default": "next_session_open",
      "title": "Entry Rule",
      "type": "string"
    },
    "exit_rule": {
      "const": "open_after_h_sessions",
      "default": "open_after_h_sessions",
      "title": "Exit Rule",
      "type": "string"
    },
    "horizon_sessions": {
      "maximum": 128,
      "minimum": 1,
      "title": "Horizon Sessions",
      "type": "integer"
    },
    "price_field": {
      "default": "open",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "title": "Price Field",
      "type": "string"
    },
    "return_type": {
      "default": "price_return",
      "enum": [
        "price_return",
        "excess_price_return"
      ],
      "title": "Return Type",
      "type": "string"
    }
  },
  "required": [
    "horizon_sessions"
  ],
  "title": "LabelRule",
  "type": "object"
}
