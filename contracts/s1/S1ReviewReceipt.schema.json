{
  "additionalProperties": false,
  "description": "S1 receipt consistency; cannot authenticate identities or grant Git actions.",
  "properties": {
    "audited_commit": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "title": "Audited Commit",
      "type": "string"
    },
    "blocking_findings": {
      "default": 0,
      "minimum": 0,
      "title": "Blocking Findings",
      "type": "integer"
    },
    "decision": {
      "default": "PENDING",
      "enum": [
        "PENDING",
        "APPROVED",
        "CHANGES_REQUIRED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "economic_status": {
      "const": "NOT_APPLICABLE",
      "default": "NOT_APPLICABLE",
      "title": "Economic Status",
      "type": "string"
    },
    "engineering_status": {
      "default": "INCOMPLETE",
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ],
      "title": "Engineering Status",
      "type": "string"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "platform_status": {
      "const": "NOT_APPLICABLE",
      "default": "NOT_APPLICABLE",
      "title": "Platform Status",
      "type": "string"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "const": "S1",
      "default": "S1",
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "audited_commit",
    "reviewer"
  ],
  "title": "S1ReviewReceipt",
  "type": "object"
}
